# Copy this file to .env (next to agent.exe, or in the project root) and fill in the keys.
# Never commit the real .env.

# OpenRouter -- https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models. Free slugs (":free") change over time -- if one returns 404, pick a
# current one at https://openrouter.ai/models?max_price=0
DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free
# Tried in order when a free model answers 429 (rate-limited upstream).
FREE_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free
# Paid model used by the evals (the cost eval must include one).
PAID_MODEL=anthropic/claude-haiku-5.5
# Fixed LLM-as-judge model for evals/compare_models.py (not one of the models under test).
JUDGE_MODEL=anthropic/claude-sonnet-5.5

# LangSmith tracing -- https://smith.langchain.com (Settings -> API Keys)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=plate-coach-ai
